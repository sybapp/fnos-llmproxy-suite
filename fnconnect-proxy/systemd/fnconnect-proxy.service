[Unit]
Description=FN Connect local API proxy for Codex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fnconnect-proxy serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/fnconnect-proxy

[Install]
WantedBy=default.target
