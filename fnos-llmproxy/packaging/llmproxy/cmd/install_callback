#!/bin/bash
set -u

UPSTREAM_FILE="${TRIM_PKGETC}/upstream_url"
value="${wizard_upstream_url:-}"

mkdir -p "${TRIM_PKGETC}" 2>/dev/null || true

if [ -z "$value" ]; then
  exit 0
fi

case "$value" in
  http://*|https://*) ;;
  *)
    echo "上游 URL 必须以 http:// 或 https:// 开头" > "${TRIM_TEMP_LOGFILE:-/tmp/llmproxy-install-error.log}"
    exit 1
    ;;
esac

case "$value" in
  *$'\n'*|*$'\r'*|*' '*)
    echo "上游 URL 不能包含空格或换行" > "${TRIM_TEMP_LOGFILE:-/tmp/llmproxy-install-error.log}"
    exit 1
    ;;
esac

printf '%s\n' "$value" > "$UPSTREAM_FILE"
chmod 600 "$UPSTREAM_FILE" 2>/dev/null || true
exit 0
